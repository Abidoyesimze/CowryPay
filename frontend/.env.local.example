# The real deployed domain (e.g. https://cowrypay.vercel.app or your custom
# domain) — resolves social-preview image URLs. Safe to leave unset locally;
# set it once the frontend is actually deployed, or previews fall back to
# http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=

# Cowry AI agent backend URL
# Leave empty to use the Next.js /api/* proxy (recommended for local dev)
NEXT_PUBLIC_AGENT_URL=

# Celo RPC (defaults to forno)
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org

# LI.FI bridge (optional here)
# LIFI_API_KEY=
# LIFI_INTEGRATOR=cowry

# ── ERC-8004 / Self Protocol agent identity ───────────────────────────────────
# A dedicated identity key for GET /api/agent/info — deliberately separate
# from the backend's AWS KMS payout wallet (this one only signs Self
# Protocol identity assertions, never moves funds, so it doesn't need
# KMS-grade custody). Generate one (e.g. `openssl rand -hex 32`, prefixed
# with 0x) if you don't have one yet, then register it:
#   npx self-agent register init --mode linked --human-address <your-wallet> --network mainnet
#   npx self-agent register open --session .self/session.json
#   npx self-agent register wait --session .self/session.json
# The "open" step gives you a deep link/QR — completing it requires
# scanning your passport/ID in the Self app; there's no way to automate
# that part.
AGENT_PRIVATE_KEY=

# Groq Whisper (voice notes — speech-to-text)
# GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Etherscan unified API (transaction history — Celo via chainid=42220)
# Free key: https://etherscan.io/apis
# ETHERSCAN_API_KEY=

# ── Backend API + Supabase Auth (email OTP → set password) ───────────────────
# CowryPay backend (Express) — user signup/login, wallet, deposits, chat.
NEXT_PUBLIC_API_URL=https://cowrypay-backend-production.up.railway.app
# Supabase Project Settings → API. The anon/publishable key is safe to expose
# client-side — never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
